generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model Department {
  id        String    @id @default(uuid())
  name      String    @unique
  code      String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  services  Service[]
}

model User {
  id                    String                  @id @default(uuid())
  fullName              String
  username              String                  @unique
  passwordHash          String
  phone                 String?
  email                 String?
  role                  Int                     @default(1)
  module                String                  @default("frontdesk")
  isActive              Boolean                 @default(true)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  auditLogs             AuditLog[]              @relation("AuditActor")
  paymentsReceived      ClinicPayment[]         @relation("CashierUser")
  pharmacyClosures      PharmacyDailyClosure[]  @relation("PharmacyClosedBy")
  pharmacySales         PharmacySale[]          @relation("PharmacySoldBy")
  stockMovementsCreated PharmacyStockMovement[] @relation("StockMovementCreatedBy")
  prescriptionsCreated  Prescription[]          @relation("PrescriptionCreatedBy")
  visitsCreated         Visit[]                 @relation("FrontdeskUser")
  resultsEntered        VisitResult[]           @relation("ResultEnteredBy")
}

model Patient {
  id                    String   @id @default(uuid())
  patientCode           String   @unique
  surname               String
  firstName             String
  middleName            String?
  sex                   String
  age                   Int
  phone                 String
  referralCenter        String
  insuranceStatus       String
  reasonForVisit        String
  emergencyContactName  String
  emergencyContactPhone String
  emergencyContactRel   String?
  isMinor               Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  visits                Visit[]
}

model Visit {
  id              String         @id @default(uuid())
  visitNumber     String         @unique
  visitDate       DateTime       @default(now())
  status          String         @default("registered")
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  patientId       String
  frontdeskUserId String
  invoice         ClinicInvoice?
  pharmacySales   PharmacySale[]
  prescriptions   Prescription[]
  frontdeskUser   User           @relation("FrontdeskUser", fields: [frontdeskUserId], references: [id])
  patient         Patient        @relation(fields: [patientId], references: [id])
  visitServices   VisitService[]
}

model Service {
  id            String                  @id @default(uuid())
  name          String
  price         Decimal
  isActive      Boolean                 @default(true)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  departmentId  String
  department    Department              @relation(fields: [departmentId], references: [id])
  templates     ServiceResultTemplate[]
  visitServices VisitService[]
}

model VisitService {
  id                String        @id @default(uuid())
  source            String        @default("frontdesk")
  unitPrice         Decimal
  quantity          Int           @default(1)
  lineTotal         Decimal
  status            String        @default("pending")
  notDoneReason     String?
  approvedByPatient Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  visitId           String
  serviceId         String
  results           VisitResult[]
  service           Service       @relation(fields: [serviceId], references: [id])
  visit             Visit         @relation(fields: [visitId], references: [id], onDelete: Cascade)
}

model ServiceResultTemplate {
  id           String        @id @default(uuid())
  templateName String?
  layoutJson   String
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  serviceId    String
  service      Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  results      VisitResult[]
}

model VisitResult {
  id              String                @id @default(uuid())
  resultDataJson  String
  narrativeNotes  String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  visitServiceId  String
  templateId      String
  enteredByUserId String
  enteredByUser   User                  @relation("ResultEnteredBy", fields: [enteredByUserId], references: [id])
  template        ServiceResultTemplate @relation(fields: [templateId], references: [id])
  visitService    VisitService          @relation(fields: [visitServiceId], references: [id], onDelete: Cascade)
}

model Prescription {
  id               String         @id @default(uuid())
  prescriptionText String
  status           String         @default("active")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  visitId          String
  createdByUserId  String
  pharmacySales    PharmacySale[]
  createdBy        User           @relation("PrescriptionCreatedBy", fields: [createdByUserId], references: [id])
  visit            Visit          @relation(fields: [visitId], references: [id], onDelete: Cascade)
}

model ClinicInvoice {
  id            String          @id @default(uuid())
  invoiceNumber String          @unique
  subtotal      Decimal
  total         Decimal
  amountPaid    Decimal         @default(0.0)
  balanceDue    Decimal
  status        String          @default("draft")
  paidAt        DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  visitId       String          @unique
  visit         Visit           @relation(fields: [visitId], references: [id], onDelete: Cascade)
  payments      ClinicPayment[]
}

model ClinicPayment {
  id               String        @id @default(uuid())
  paymentMethod    String
  amount           Decimal
  referenceNumber  String?
  paidAt           DateTime      @default(now())
  createdAt        DateTime      @default(now())
  invoiceId        String
  receivedByUserId String
  receivedByUser   User          @relation("CashierUser", fields: [receivedByUserId], references: [id])
  invoice          ClinicInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model PharmacyProduct {
  id             String                  @id @default(uuid())
  productCode    String?                 @unique
  name           String
  unitOfMeasure  String
  isActive       Boolean                 @default(true)
  reorderLevel   Float                   @default(10.0)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  batches        PharmacyBatch[]
  saleItems      PharmacySaleItem[]
  stockMovements PharmacyStockMovement[]
}

model PharmacyBatch {
  id                String                  @id @default(uuid())
  batchNumber       String
  expiryDate        DateTime
  purchasePrice     Decimal
  sellingPrice      Decimal
  quantityReceived  Float
  quantityRemaining Float
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  productId         String
  product           PharmacyProduct         @relation(fields: [productId], references: [id], onDelete: Cascade)
  saleItems         PharmacySaleItem[]
  stockMovements    PharmacyStockMovement[]
}

model PharmacyStockMovement {
  id              String          @id @default(uuid())
  movementType    String
  quantity        Float
  unitCost        Decimal?
  referenceId     String?
  createdAt       DateTime        @default(now())
  productId       String
  batchId         String?
  createdByUserId String
  createdByUser   User            @relation("StockMovementCreatedBy", fields: [createdByUserId], references: [id])
  batch           PharmacyBatch?  @relation(fields: [batchId], references: [id])
  product         PharmacyProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model PharmacySale {
  id             String                @id @default(uuid())
  saleNumber     String                @unique
  saleSource     String                @default("walk_in")
  subtotal       Decimal
  total          Decimal
  paymentMethod  String
  status         String                @default("paid")
  paidAt         DateTime              @default(now())
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  visitId        String?
  prescriptionId String?
  soldByUserId   String
  closureId      String?
  closure        PharmacyDailyClosure? @relation("PharmacyClosureSales", fields: [closureId], references: [id])
  soldByUser     User                  @relation("PharmacySoldBy", fields: [soldByUserId], references: [id])
  prescription   Prescription?         @relation(fields: [prescriptionId], references: [id])
  visit          Visit?                @relation(fields: [visitId], references: [id])
  items          PharmacySaleItem[]
}

model PharmacySaleItem {
  id        String          @id @default(uuid())
  itemName  String
  quantity  Float
  unitPrice Decimal
  lineTotal Decimal
  createdAt DateTime        @default(now())
  saleId    String
  productId String
  batchId   String?
  batch     PharmacyBatch?  @relation(fields: [batchId], references: [id])
  product   PharmacyProduct @relation(fields: [productId], references: [id])
  sale      PharmacySale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id          String   @id @default(uuid())
  actionType  String
  entityType  String
  entityId    String
  beforeData  String?
  afterData   String?
  createdAt   DateTime @default(now())
  actorUserId String
  actorUser   User     @relation("AuditActor", fields: [actorUserId], references: [id])
}

model PharmacyDailyClosure {
  id               String         @id @default(uuid())
  closedByUserId   String
  closureDate      DateTime       @default(now())
  totalSalesCount  Int
  totalSalesAmount Decimal
  cashCounted      Decimal
  momoCounted      Decimal
  totalCounted     Decimal
  discrepancy      Decimal
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  closedByUser     User           @relation("PharmacyClosedBy", fields: [closedByUserId], references: [id])
  sales            PharmacySale[] @relation("PharmacyClosureSales")
}

generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  logo             String?
  tagline          String?
  location         String?
  phone            String?
  email            String?
  tollFree         String?
  labEmail         String?
  accreditationId  String?

  users            User[]
  patients         Patient[]
  departments      Department[]
  services         Service[]
  visits           Visit[]
  clinicInvoices   ClinicInvoice[]
  clinicPayments   ClinicPayment[]
  pharmacyProducts PharmacyProduct[]
  pharmacySales    PharmacySale[]
  prescriptions    Prescription[]
  auditLogs        AuditLog[]
  closures         PharmacyDailyClosure[]
  generalTemplates GeneralTemplate[]
  expenses         Expense[]
}

model Department {
  id        String    @id @default(uuid())
  name      String
  code      String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  tenantId  String?
  tenant    Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  services  Service[]

  @@unique([tenantId, name])
}

model User {
  id                    String                  @id @default(uuid())
  fullName              String
  username              String?
  passwordHash          String
  phone                 String?
  email                 String                  @unique
  role                  Int                     @default(1)
  roles                 String                  @default("1")
  module                String                  @default("frontdesk")
  isActive              Boolean                 @default(true)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  tenantId              String?
  tenant                Tenant?                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inviteToken           String?                 @unique
  inviteExpires         DateTime?
  isVerified            Boolean                 @default(false)
  auditLogs             AuditLog[]              @relation("AuditActor")
  paymentsReceived      ClinicPayment[]         @relation("CashierUser")
  pharmacyClosures      PharmacyDailyClosure[]  @relation("PharmacyClosedBy")
  pharmacyOpenedClosures PharmacyDailyClosure[] @relation("PharmacyOpenedBy")
  pharmacySales         PharmacySale[]          @relation("PharmacySoldBy")
  stockMovementsCreated PharmacyStockMovement[] @relation("StockMovementCreatedBy")
  prescriptionsCreated  Prescription[]          @relation("PrescriptionCreatedBy")
  visitsCreated         Visit[]                 @relation("FrontdeskUser")
  resultsEntered        VisitResult[]           @relation("ResultEnteredBy")
  voidedClinicPayments  ClinicPayment[]         @relation("ClinicPaymentVoidedBy")
  voidedPharmacySales  PharmacySale[]          @relation("PharmacySaleVoidedBy")
  expensesCreated       Expense[]               @relation("ExpenseCreatedBy")

  @@unique([tenantId, username])
}

model Patient {
  id                    String   @id @default(uuid())
  patientCode           String
  surname               String
  firstName             String
  middleName            String?
  sex                   String
  age                   Int
  phone                 String
  referralCenter        String
  insuranceStatus       String
  reasonForVisit        String?
  emergencyContactName  String?
  emergencyContactPhone String?
  emergencyContactRel   String?
  isMinor               Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  tenantId              String?
  tenant                Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  visits                Visit[]

  @@unique([tenantId, patientCode])
}

model Visit {
  id              String         @id @default(uuid())
  visitNumber     String
  visitDate       DateTime       @default(now())
  status          String         @default("registered")
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  patientId       String
  frontdeskUserId String
  tenantId        String?
  tenant          Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice         ClinicInvoice?
  pharmacySales   PharmacySale[]
  prescriptions   Prescription[]
  frontdeskUser   User           @relation("FrontdeskUser", fields: [frontdeskUserId], references: [id])
  patient         Patient        @relation(fields: [patientId], references: [id])
  visitServices   VisitService[]

  @@unique([tenantId, visitNumber])
}

model Service {
  id            String                  @id @default(uuid())
  name          String
  price         Decimal
  isActive      Boolean                 @default(true)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  departmentId  String
  tenantId      String?
  tenant        Tenant?                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department    Department              @relation(fields: [departmentId], references: [id])
  templates     ServiceResultTemplate[]
  visitServices VisitService[]
  generalTemplateItems GeneralTemplateService[]
}

model VisitService {
  id                String        @id @default(uuid())
  source            String        @default("frontdesk")
  unitPrice         Decimal
  quantity          Int           @default(1)
  lineTotal         Decimal
  status            String        @default("pending")
  notDoneReason     String?
  approvedByPatient Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  visitId           String
  serviceId         String
  results           VisitResult[]
  service           Service       @relation(fields: [serviceId], references: [id])
  visit             Visit         @relation(fields: [visitId], references: [id], onDelete: Cascade)
}

model ServiceResultTemplate {
  id           String        @id @default(uuid())
  templateName String?
  layoutJson   String
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  serviceId    String
  service      Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  results      VisitResult[]
}

model VisitResult {
  id              String                @id @default(uuid())
  resultDataJson  String
  narrativeNotes  String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  visitServiceId  String
  templateId      String
  enteredByUserId String
  enteredByUser   User                  @relation("ResultEnteredBy", fields: [enteredByUserId], references: [id])
  template        ServiceResultTemplate @relation(fields: [templateId], references: [id])
  visitService    VisitService          @relation(fields: [visitServiceId], references: [id], onDelete: Cascade)
}

model Prescription {
  id               String         @id @default(uuid())
  prescriptionText String
  status           String         @default("active")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  visitId          String
  createdByUserId  String
  tenantId         String?
  tenant           Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pharmacySales    PharmacySale[]
  createdBy        User           @relation("PrescriptionCreatedBy", fields: [createdByUserId], references: [id])
  visit            Visit          @relation(fields: [visitId], references: [id], onDelete: Cascade)
}

model ClinicInvoice {
  id            String          @id @default(uuid())
  invoiceNumber String
  subtotal      Decimal
  total         Decimal
  amountPaid    Decimal         @default(0.0)
  balanceDue    Decimal
  status        String          @default("draft")
  paidAt        DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  visitId       String          @unique
  tenantId      String?
  tenant        Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  visit         Visit           @relation(fields: [visitId], references: [id], onDelete: Cascade)
  payments      ClinicPayment[]

  @@unique([tenantId, invoiceNumber])
}

model ClinicPayment {
  id               String        @id @default(uuid())
  paymentMethod    String
  amount           Decimal
  referenceNumber  String?
  paidAt           DateTime      @default(now())
  createdAt        DateTime      @default(now())
  invoiceId        String
  receivedByUserId String
  status           String        @default("paid")
  voidReason       String?
  voidedByUserId   String?
  voidedAt         DateTime?
  tenantId         String?
  tenant           Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  receivedByUser   User          @relation("CashierUser", fields: [receivedByUserId], references: [id])
  voidedByUser     User?         @relation("ClinicPaymentVoidedBy", fields: [voidedByUserId], references: [id])
  invoice          ClinicInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model PharmacyProduct {
  id             String                  @id @default(uuid())
  productCode    String?
  name           String
  unitOfMeasure  String
  isActive       Boolean                 @default(true)
  reorderLevel   Float                   @default(10.0)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  tenantId       String?
  tenant         Tenant?                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  batches        PharmacyBatch[]
  saleItems      PharmacySaleItem[]
  stockMovements PharmacyStockMovement[]

  @@unique([tenantId, productCode])
}

model PharmacyBatch {
  id                String                  @id @default(uuid())
  batchNumber       String
  expiryDate        DateTime
  purchasePrice     Decimal
  sellingPrice      Decimal
  quantityReceived  Float
  quantityRemaining Float
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  productId         String
  product           PharmacyProduct         @relation(fields: [productId], references: [id], onDelete: Cascade)
  saleItems         PharmacySaleItem[]
  stockMovements    PharmacyStockMovement[]
}

model PharmacyStockMovement {
  id              String          @id @default(uuid())
  movementType    String
  quantity        Float
  unitCost        Decimal?
  referenceId     String?
  createdAt       DateTime        @default(now())
  productId       String
  batchId         String?
  createdByUserId String
  createdByUser   User            @relation("StockMovementCreatedBy", fields: [createdByUserId], references: [id])
  batch           PharmacyBatch?  @relation(fields: [batchId], references: [id])
  product         PharmacyProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model PharmacySale {
  id             String                @id @default(uuid())
  saleNumber     String
  saleSource     String                @default("walk_in")
  subtotal       Decimal
  total          Decimal
  paymentMethod  String
  status         String                @default("paid")
  paidAt         DateTime              @default(now())
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  visitId        String?
  prescriptionId String?
  soldByUserId   String
  closureId      String?
  voidReason     String?
  voidedByUserId String?
  voidedAt       DateTime?
  tenantId       String?
  tenant         Tenant?               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  closure        PharmacyDailyClosure? @relation("PharmacyClosureSales", fields: [closureId], references: [id])
  soldByUser     User                  @relation("PharmacySoldBy", fields: [soldByUserId], references: [id])
  voidedByUser   User?                 @relation("PharmacySaleVoidedBy", fields: [voidedByUserId], references: [id])
  prescription   Prescription?         @relation(fields: [prescriptionId], references: [id])
  visit          Visit?                @relation(fields: [visitId], references: [id])
  items          PharmacySaleItem[]

  @@unique([tenantId, saleNumber])
}

model PharmacySaleItem {
  id        String          @id @default(uuid())
  itemName  String
  quantity  Float
  unitPrice Decimal
  lineTotal Decimal
  createdAt DateTime        @default(now())
  saleId    String
  productId String
  batchId   String?
  batch     PharmacyBatch?  @relation(fields: [batchId], references: [id])
  product   PharmacyProduct @relation(fields: [productId], references: [id])
  sale      PharmacySale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id          String   @id @default(uuid())
  actionType  String
  entityType  String
  entityId    String
  beforeData  String?
  afterData   String?
  createdAt   DateTime @default(now())
  actorUserId String
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorUser   User     @relation("AuditActor", fields: [actorUserId], references: [id])
}

model PharmacyDailyClosure {
  id               String         @id @default(uuid())
  openedByUserId   String
  closedByUserId   String?
  closureDate      DateTime?
  totalSalesCount  Int?
  totalSalesAmount Decimal?
  openingFloat     Decimal        @default(0.00)
  cashCounted      Decimal?
  momoCounted      Decimal?
  totalCounted     Decimal?
  discrepancy      Decimal?
  notes            String?
  status           String         @default("open")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  tenantId         String?
  tenant           Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  openedByUser     User           @relation("PharmacyOpenedBy", fields: [openedByUserId], references: [id])
  closedByUser     User?          @relation("PharmacyClosedBy", fields: [closedByUserId], references: [id])
  sales            PharmacySale[] @relation("PharmacyClosureSales")
}

model GeneralTemplate {
  id        String                   @id @default(uuid())
  name      String
  isActive  Boolean                  @default(true)
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt
  tenantId  String?
  tenant    Tenant?                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items     GeneralTemplateService[]

  @@unique([tenantId, name])
}

model GeneralTemplateService {
  id                String          @id @default(uuid())
  generalTemplateId String
  serviceId         String
  sortOrder         Int             @default(0)
  generalTemplate   GeneralTemplate @relation(fields: [generalTemplateId], references: [id], onDelete: Cascade)
  service           Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([generalTemplateId, serviceId])
}

model Expense {
  id            String   @id @default(uuid())
  title         String
  category      String
  amount        Decimal
  expenseDate   DateTime @default(now())
  notes         String?
  createdById   String
  createdByUser User     @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tenantId      String?
  tenant        Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

